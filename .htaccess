# =========================================================
# MODE ATTENTE
# Seules la page d'attente et les pages legales sont servies. Le reste du site
# existe toujours dans le depot, il n'est simplement plus accessible.
# Pour rouvrir le site en entier : commenter ce bloc, rien d'autre.
# Redirection en 302 et non 301 : un 301 serait mis en cache definitivement par
# les navigateurs et continuerait de rediriger apres la reouverture.
# =========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  # L'habillage reste servi : polices, images, feuille de style, script
  RewriteCond %{REQUEST_URI} !^/(assets|css|js)/ [NC]
  # Ces pages restent accessibles, les mentions legales etant obligatoires
  RewriteCond %{REQUEST_URI} !^/(index\.html|mentions-legales\.html|confidentialite\.html)$ [NC]
  RewriteCond %{REQUEST_URI} !^/(favicon\.ico|robots\.txt|sitemap\.xml)$ [NC]
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^ / [R=302,L]
</IfModule>

# Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml font/ttf font/otf
</IfModule>
# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|ttf|otf|svg|webp|jpg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
