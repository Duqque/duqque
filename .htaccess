# Page d'erreur du site. Elle doit rester joignable meme en mode attente,
# elle figure donc dans les exceptions de la redirection ci-dessous.
ErrorDocument 404 /404.html

# =========================================================
# MODE ATTENTE
# Seules la page d'attente et les pages legales sont servies. Le reste du site
# existe toujours dans le depot, il n'est simplement plus accessible.
# Pour rouvrir le site en entier : commenter ce bloc, rien d'autre.
# Redirection en 302 et non 301 : un 301 serait mis en cache definitivement par
# les navigateurs et continuerait de rediriger apres la reouverture.
# =========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------------------------------------------------------
  # ACCES ADMINISTRATEUR
  # /acces.html demande un mot de passe et pose le cookie duqque_apercu.
  # Le mot de passe et le jeton vivent dans acces-cle.js, exclu du depot.
  # Deconnexion : /?apercu=stop
  # ---------------------------------------------------------
  RewriteCond %{QUERY_STRING} (^|&)apercu=stop($|&) [NC]
  RewriteRule ^ - [CO=duqque_apercu:non:%{HTTP_HOST}:-1:/]

  # Porteur du cookie : le site entier s'ouvre.
  RewriteCond %{HTTP_COOKIE} duqque_apercu=ouvert- [NC]
  RewriteRule ^ - [L]

  # La page d'acces elle-meme reste evidemment joignable
  RewriteCond %{REQUEST_URI} ^/(acces\.html|acces-cle\.js|resultats\.html)$ [NC]
  RewriteRule ^ - [L]

  # Les points d'entree du serveur restent servis meme en mode attente : sans eux
  # un participant ne pourrait pas envoyer son questionnaire, et l'administration
  # ne pourrait pas se connecter.
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # L'habillage reste servi : polices, images, feuille de style, script
  RewriteCond %{REQUEST_URI} !^/(assets|css|js)/ [NC]
  # Ces pages restent accessibles, les mentions legales etant obligatoires
  RewriteCond %{REQUEST_URI} !^/(index\.html|mentions-legales\.html|confidentialite\.html)$ [NC]
  RewriteCond %{REQUEST_URI} !^/(favicon\.ico|robots\.txt|sitemap\.xml|404\.html)$ [NC]
  RewriteCond %{REQUEST_URI} !^/$
  # Uniquement pour un fichier qui existe : une adresse inexistante doit aboutir
  # a une vraie 404, pas etre silencieusement renvoyee vers l'accueil.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ / [R=302,L]
</IfModule>

# Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml font/ttf font/otf
</IfModule>
# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|ttf|otf|svg|webp|jpg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
